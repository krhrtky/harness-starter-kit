{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.local/schema/v1/interfaces.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "enum": [
              "H00",
              "H01",
              "H02",
              "H03",
              "H04",
              "H05",
              "H06",
              "H07",
              "H08",
              "H09",
              "H10",
              "H11",
              "H12",
              "H13",
              "H14",
              "H15",
              "H16",
              "H17",
              "H18",
              "H19",
              "H20",
              "H21",
              "H22",
              "H23",
              "H24",
              "H25",
              "H26"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "family": {
            "enum": [
              "delivery",
              "evolution"
            ]
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "readiness": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "knowledge": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "name",
          "family",
          "owner",
          "readiness",
          "sources",
          "capabilities",
          "knowledge"
        ],
        "additionalProperties": false
      },
      "minItems": 27,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "interfaces"
  ],
  "additionalProperties": false
}
