{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.local/schema/v1/knowledge.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
          },
          "interface": {
            "enum": [
              "H00",
              "H01",
              "H02",
              "H03",
              "H04",
              "H05",
              "H06",
              "H07",
              "H08",
              "H09",
              "H10",
              "H11",
              "H12",
              "H13",
              "H14",
              "H15",
              "H16",
              "H17",
              "H18",
              "H19",
              "H20",
              "H21",
              "H22",
              "H23",
              "H24",
              "H25",
              "H26"
            ]
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "unknown",
              "documented"
            ]
          },
          "reviewed_at": {
            "type": "string",
            "format": "date-time"
          },
          "content_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "path",
          "interface",
          "owner",
          "status",
          "reviewed_at",
          "content_digest"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "documents"
  ],
  "additionalProperties": false
}
