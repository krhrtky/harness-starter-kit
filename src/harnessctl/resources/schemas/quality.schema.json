{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.local/schema/v1/quality.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "scores": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scope": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
          },
          "dimension": {
            "enum": [
              "correctness",
              "architecture",
              "tests",
              "observability",
              "documentation",
              "maintainability"
            ]
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "basis": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "scope",
          "dimension",
          "score",
          "basis",
          "evidence"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "scores"
  ],
  "additionalProperties": false
}
