{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.local/schema/v1/eval.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
    },
    "task": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
    },
    "first_pass": {
      "type": "boolean"
    },
    "human_interventions": {
      "type": "integer",
      "minimum": 0
    },
    "rework": {
      "type": "integer",
      "minimum": 0
    },
    "asset_miss": {
      "type": "boolean"
    },
    "architecture_violation": {
      "type": "boolean"
    },
    "escaped_defect": {
      "type": "boolean"
    },
    "reviewer_disagreement": {
      "type": "boolean"
    },
    "reused_assets": {
      "type": "integer",
      "minimum": 0
    },
    "new_assets": {
      "type": "integer",
      "minimum": 0
    },
    "time_to_evidence_seconds": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "schema_version",
    "id",
    "task",
    "first_pass",
    "human_interventions",
    "rework",
    "asset_miss",
    "architecture_violation",
    "escaped_defect",
    "reviewer_disagreement",
    "reused_assets",
    "new_assets",
    "time_to_evidence_seconds"
  ],
  "additionalProperties": false
}
