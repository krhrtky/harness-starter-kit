{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.local/schema/v1/receipt.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
    },
    "task_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "quality": {
      "$ref": "quality.schema.json"
    },
    "control_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "assets": {
      "$ref": "assets.schema.json"
    }
  },
  "required": [
    "schema_version",
    "task",
    "task_digest",
    "created_at",
    "source_digest",
    "files",
    "quality",
    "control_digest",
    "assets"
  ],
  "additionalProperties": false
}
