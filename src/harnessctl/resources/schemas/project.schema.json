{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.local/schema/v1/project.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "greenfield",
        "brownfield"
      ]
    },
    "maturity": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "team_bundle": {
      "type": [
        "string",
        "null"
      ]
    },
    "team_digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "name",
    "mode",
    "maturity",
    "owner",
    "team_bundle",
    "team_digest"
  ],
  "additionalProperties": false
}
